<div class="text-center py-4">
  <div class="fs-1">🔥</div>
  <h1>Hearth</h1>
  <p class="lead">Mentors who remember you.</p>
  <p class="text-muted">
    Living alone for the first time? Hearth gives you six friendly AI mentors
    for the small stuff that feels big: stress, cooking, money, sleep and focus.
  </p>

  <% if user_signed_in? %>
    <%= link_to "Meet the mentors", mentors_path, class: "btn btn-primary btn-lg" %>
    <%= link_to "My chats", chats_path, class: "btn btn-outline-primary btn-lg" %>
  <% else %>
    <%= link_to "Get started", new_user_registration_path, class: "btn btn-primary btn-lg" %>
    <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-primary btn-lg" %>
  <% end %>
</div>
