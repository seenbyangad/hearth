<div class="d-flex align-items-center gap-3 mb-4">
  <div class="mentor-avatar"><%= @chat.mentor.avatar %></div>
  <div>
    <h1 class="h3 mb-0"><%= @chat.mentor.name %></h1>
    <small class="text-muted"><%= @chat.title %></small>
  </div>
</div>

<div class="card p-4 text-center text-muted">
  <p class="mb-0">This is the start of your chat with <%= @chat.mentor.name %>.</p>
  <p class="mb-0">Messages are coming soon!</p>
</div>

<div class="mt-3">
  <%= link_to "← Back to #{@chat.mentor.name}", mentor_path(@chat.mentor) %>
</div>
