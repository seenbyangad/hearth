<div class="text-center">
  <div class="mentor-avatar mentor-avatar-big"><%= @mentor.avatar %></div>
  <h1><%= @mentor.name %></h1>
  <p class="text-muted"><%= @mentor.specialty %></p>
  <p class="lead"><%= @mentor.tagline %></p>

  <%= button_to "Talk to #{@mentor.name}", mentor_chats_path(@mentor), class: "btn btn-primary btn-lg mb-4" %>
</div>

<% if @chats.any? %>
  <h2 class="h5">Your past chats with <%= @mentor.name %></h2>
  <div class="list-group mb-4">
    <% @chats.each do |chat| %>
      <%= link_to chat_path(chat), class: "list-group-item list-group-item-action" do %>
        <div class="fw-bold"><%= chat.title %></div>
        <small class="text-muted"><%= chat.created_at.strftime("%d %b %Y") %></small>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="text-center">
  <%= link_to "← Back to all mentors", mentors_path %>
</div>
